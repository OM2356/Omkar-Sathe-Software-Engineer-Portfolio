# GEMINI_API_KEY: Required for Gemini AI API calls if server-side AI features are enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_EMAIL: Verified Google account email authorized for Admin Dashboard & default email receiver.
ADMIN_EMAIL="omkarsathe3103@gmail.com"

# CONTACT_RECEIVER_EMAIL: Destination email address for contact form submissions (defaults to ADMIN_EMAIL).
CONTACT_RECEIVER_EMAIL="omkarsathe3103@gmail.com"

# Gmail SMTP Configuration for Nodemailer
# For Gmail, enable 2-Step Verification and generate an App Password for SMTP_PASS.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-gmail@gmail.com"
SMTP_PASS="your-16-char-gmail-app-password"

# GitHub Integration (Server-side only — never exposed to browser)
GITHUB_TOKEN="your-github-personal-access-token"
GITHUB_USERNAME="your-github-username"
